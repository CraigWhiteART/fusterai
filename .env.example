APP_NAME=FusterAI
APP_ENV=local
APP_KEY=                          # Run: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost
APP_HOST=localhost
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fusterai
DB_USERNAME=fusterai
DB_PASSWORD=secret

# ── Cache / Sessions / Queues (Redis) ─────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── WebSockets (Reverb) ────────────────────────────────────────────────────────
# REQUIRED: change APP_KEY and REVERB_APP_KEY/SECRET before running.
# Without valid Reverb keys, WebSockets silently fail (real-time updates, live chat, AI streaming).
REVERB_APP_ID=fusterai
REVERB_APP_KEY=change-me-random-32-char-string
REVERB_APP_SECRET=change-me-random-32-char-string
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── AI ────────────────────────────────────────────────────────────────────────
# Configure your AI provider via Settings → AI Config in the admin panel.
# These .env values are only used as fallbacks if no DB config is saved.
# AI_DEFAULT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# AI feature flags — all default to true when an API key is configured
# AI_REPLY_SUGGESTIONS=true
# AI_AUTO_CATEGORIZATION=true
# AI_SUMMARIZATION=true
# AI_RAG=true

# Embeddings are configured per workspace (Settings → AI Config → Embeddings).
# Set to true to let workspaces without their own embeddings settings use
# OPENAI_API_KEY; the settings page shows when this fallback is in use.
# AI_EMBEDDINGS_ENV_FALLBACK=false
# AI_EMBEDDINGS_MODEL=text-embedding-3-small
# Postgres text-search configuration for keyword retrieval ('simple' = no stemming)
# AI_FTS_CONFIG=english

# ── Queue Manager (Horizon) ───────────────────────────────────────────────────
# REQUIRED: Horizon processes background jobs (email fetch, AI, notifications).
# Without Horizon running, emails will not arrive and AI features will not work.
# retry_after MUST stay above the longest Horizon supervisor timeout on that
# connection (config/horizon.php: ai = 330s on "redis", ai-bulk = 900s on
# "redis-long"), or a slow job is started a second time while still running.
# Do not copy an old REDIS_QUEUE_RETRY_AFTER=90 into a new .env.
# REDIS_QUEUE_RETRY_AFTER=360
# REDIS_LONG_QUEUE_RETRY_AFTER=960

# ── AI agent (docs/agent-go-live.md; defaults shown) ──────────────────────────
# Mode, kill switch, models, caps and auto-send are set per workspace in the
# app (Agent → Settings). These env values tune limits and queues only.
# AGENT_WRITER_MODE=tools               # tools = writer tool loop; structured = one structured call (fallback)
# AGENT_FEEDBACK_AUTO_GATE=true         # run the regression gate automatically on feedback proposals
# AGENT_GATE_QUEUE=ai
# AGENT_GATE_QUEUE_CONNECTION=
# AGENT_SIMULATION_QUEUE=ai-bulk
# AGENT_SIMULATION_QUEUE_CONNECTION=redis-long
# Auto-send (docs/agent-autosend.md)
# AGENT_AUTO_MIN_TEST_CASES=5
# AGENT_AUTO_MIN_PASS_RATE=0.9
# AGENT_AUTO_MAX_PER_HOUR=10            # global breaker: more pauses all auto-sending
# AGENT_SHADOW_SAMPLE_RATE=1.0
# AGENT_SHADOW_DAILY_CAP=50
# History mining (docs/agent-mining.md)
# AGENT_MINING_MONTHS=18
# AGENT_MINING_MAX_CONVERSATIONS=3000
# AGENT_MINING_BUDGET_USD=25
# AGENT_MINING_ORDER_PREFIXES=SD        # order-number prefixes scrubbed from mined text
# AGENT_MINING_QUEUE=ai-bulk
# AGENT_MINING_QUEUE_CONNECTION=redis-long
# AGENT_MINING_STEP_SECONDS=120
# AGENT_MINING_THROTTLE_SECONDS=2
# Manager chat (docs/agent-manager.md)
# AGENT_MANAGER_DAILY_COST_CAP_USD=5.0
# AGENT_MANAGER_MAX_INPUT_TOKENS=200000
# AGENT_MANAGER_MAX_STEPS=10
# AGENT_MANAGER_QUEUE=ai
# QA reviews (docs/agent-qa.md)
# AGENT_QA_ENABLED=true
# AGENT_QA_DELAY_MINUTES=10
# AGENT_QA_SAMPLE_RATE=1.0
# AGENT_QA_FULL_SAMPLE_RATE=0.15
# AGENT_QA_DAILY_CAP=60
# AGENT_QA_GAP_THRESHOLD=3
# AGENT_QA_QUEUE=ai
# AGENT_QA_BACKFILL_QUEUE=ai-bulk
# AGENT_QA_BACKFILL_CONNECTION=redis-long
# Shopify actions (docs/agent-actions.md)
# AGENT_ACTIONS_HELPDESK_NAME=fusterai  # named in the audit note added to Shopify orders
# AGENT_ACTIONS_QUEUE=default
# Commerce (Shopify / carrier tracking; credentials are saved in Agent → Connections)
# COMMERCE_ASSIST_SHOPIFY_API_VERSION=2026-10
# COMMERCE_ASSIST_TRACKING_PROVIDER=none

# ── Search ────────────────────────────────────────────────────────────────────
# 'database' works out of the box. Switch to 'meilisearch' for production full-text search.
# Docker setup defaults to meilisearch (service is included in docker-compose.yml).
SCOUT_DRIVER=database
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# ── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=log                   # Change to smtp in production
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mail sync (config/mailsync.php, docs/mail-sync.md)
# MAIL_SYNC_INITIAL_LOOKBACK_DAYS=3     # first emails:fetch also takes the last N days
# MAIL_MAX_ATTACHMENT_BYTES=20971520    # per-file cap for inbound attachments
# MAIL_SYNC_MAX_BODIES_PER_RUN=200
# MAIL_SYNC_REINGEST_AFTER_MINUTES=10
# History backfill (Agent → Import, docs/mail-sync.md)
# MAIL_BACKFILL_MONTHS=18
# MAIL_BACKFILL_INCLUDE_UNANSWERED=false
# MAIL_BACKFILL_ACTIVE_WINDOW_DAYS=14
# MAIL_BACKFILL_QUEUE=ai-bulk
# MAIL_BACKFILL_QUEUE_CONNECTION=redis-long
# MAIL_BACKFILL_STEP_SECONDS=120
# MAIL_BACKFILL_THROTTLE_SECONDS=3
# MAIL_BACKFILL_RANGE_SIZE=500
# MAIL_BACKFILL_RANGES_PER_SLICE=4
# MAIL_BACKFILL_THREADS_PER_SLICE=25
# MAIL_BACKFILL_BODIES_PER_SLICE=100
# MAIL_BACKFILL_MAX_SLICES_PER_STEP=500
# MAIL_BACKFILL_MAX_CONSECUTIVE_ERRORS=8
# MAIL_BACKFILL_STALL_MINUTES=20

# ── Storage (optional S3) ──────────────────────────────────────────────────────
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# ── Laravel Passport (OAuth 2.1 / MCP) ────────────────────────────────────────
# Generate with: php artisan passport:keys
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# Set to true when running HTTPS in production
# SESSION_SECURE_COOKIE=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the REST API. Use * in dev only.
CORS_ALLOWED_ORIGINS=*

VITE_APP_NAME="${APP_NAME}"
